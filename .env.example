# =============================================================================
# AdvAqui — Variáveis de ambiente (template)
# =============================================================================
# Copie este arquivo para `.env.local` e preencha com seus valores reais.
# Nunca faça commit do `.env.local` no Git (já está em .gitignore).
#
# Variáveis que começam com `NEXT_PUBLIC_` ficam disponíveis no navegador.
# As demais ficam APENAS no servidor (Route Handlers, Server Components).
# =============================================================================

# ---------- Marca e domínio ----------
NEXT_PUBLIC_SITE_NAME="AdvAqui"
NEXT_PUBLIC_SITE_URL="https://advaqui.com"
NEXT_PUBLIC_SITE_DESCRIPTION="Encontre o advogado certo na sua cidade. Diretório nacional com cobertura em todos os municípios brasileiros."

# ---------- Pagamento Pix ----------
# Chave Pix do recebedor. Aparece no QR Code e copia-e-cola gerados na página /painel/pagamento.
PIX_KEY="sua-chave-pix-aqui"
PIX_RECEIVER_NAME="Nome do recebedor"
PIX_RECEIVER_CITY="JEQUITINHONHA"
PIX_AMOUNT="59.90"

# ---------- Painel admin (acesso único, sem signup) ----------
# Credenciais validadas no endpoint server-side /api/auth/admin.
# TROCAR em produção. Senha forte (mínimo 15 caracteres com letras, números e símbolos).
ADMIN_EMAIL="seu@email.com"
ADMIN_PASSWORD="trocar-essa-senha-imediatamente"

# Segredo usado para assinar o cookie httpOnly admin (HMAC SHA-256).
# Gere com: `openssl rand -hex 32` ou similar (mínimo 16 caracteres).
ADMIN_SESSION_SECRET="gere-um-segredo-aleatorio-de-32-caracteres-aqui"

# ---------- Supabase (banco de dados + auth) ----------
# Obtenha em: https://supabase.com → seu projeto → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<sua-publishable-key-aqui>"
# IMPORTANTE — SECRET KEY tem poder TOTAL sobre o banco (ignora RLS).
# Nunca exponha em código client-side. Só usar em Route Handlers.
SUPABASE_SECRET_KEY="<sua-secret-key-aqui>"

# ---------- Notificações ao admin (opcional, fase 2) ----------
# Bot Telegram avisa quando alguém marca "já paguei" no /painel/pagamento.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---------- E-mail transacional (opcional, fase 2) ----------
# Resend é gratuito até 3 mil e-mails/mês. Necessário para recuperação de senha
# funcionar SEM o limite de 3 e-mails/hora do SMTP padrão do Supabase.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="contato@advaqui.com"
