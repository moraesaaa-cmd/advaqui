# --- Supabase ---
# Use a chave service_role (SECRET_KEY no AdvAqui)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# --- Coleta ---
# Modo de operação do coletor AUTOMÁTICO (cron):
#   disabled  → cron não coleta nada (DEFAULT seguro até validação)
#   enabled   → cron coleta diariamente via main.py
# Para execução MANUAL ignore JURIS_MODE e use --force, ex.:
#   python3 main.py --source=stj-ckan --mode=main --limit=200 --force
JURIS_MODE=disabled

# --- Fontes ---
# STJ: usa Portal de Dados Abertos (CKAN) — main.py --source=stj-ckan
# STF: ainda não implementado (portal protegido por AWS WAF)
#      ver docs/stf-jurisprudencia-fontes.md

# Tamanho do batch por execução (onda 1: 100)
JURIS_IMPORT_BATCH_SIZE=100

# TTL do cache de inteiro teor (dias) — não exceder 30
JURIS_CACHE_TTL_DAYS=7

# Alerta de armazenamento (MB) — pausa coleta se ultrapassar
MAX_DB_SIZE_WARNING_MB=400

# Contato pra User-Agent (mostrado pros portais STF/STJ)
JURIS_CONTACT_EMAIL=contato@advaqui.com.br

# Rate limit (segundos entre requisições por domínio)
JURIS_REQ_INTERVAL_SECONDS=1.0

# Timeout HTTP em segundos
JURIS_HTTP_TIMEOUT=20

# Máximo de retries em 429/5xx
JURIS_MAX_RETRIES=3
