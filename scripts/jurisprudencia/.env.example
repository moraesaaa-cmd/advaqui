# --- Supabase ---
# Use a chave service_role (SECRET_KEY no AdvAqui)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# --- Coleta ---
# Modo de operação:
#   disabled  → não faz nada (DEFAULT EM PRODUÇÃO — seguro)
#   fixtures  → gera dados SINTÉTICOS de desenvolvimento (NUNCA em produção)
#   real-stf  → coleta apenas STF (coletor real ainda não implementado)
#   real-stj  → coleta apenas STJ (coletor real ainda não implementado)
#   real      → coleta STF + STJ
JURIS_MODE=disabled

# Tamanho do batch por execução (onda 1: 100)
JURIS_IMPORT_BATCH_SIZE=100

# TTL do cache de inteiro teor (dias) — não exceder 30
JURIS_CACHE_TTL_DAYS=7

# Alerta de armazenamento (MB) — pausa coleta se ultrapassar
MAX_DB_SIZE_WARNING_MB=400

# Contato pra User-Agent (mostrado pros portais STF/STJ)
JURIS_CONTACT_EMAIL=contato@advaqui.com.br

# Rate limit (segundos entre requisições por domínio)
JURIS_REQ_INTERVAL_SECONDS=1.0

# Timeout HTTP em segundos
JURIS_HTTP_TIMEOUT=20

# Máximo de retries em 429/5xx
JURIS_MAX_RETRIES=3
